      "id": "2",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const customer = $json.customer_name;\nconst city = $json.city;\n\nconst orders = $json.orders;\n\nreturn orders.map(order => ({\n  json: {\n    customer_name: customer,\n    city: city,\n    order_id: order.order_id,\n    product: order.product,\n    amount: order.amount,\n    order_date: order.order_date,\n    amount_with_tax: Math.round(order.amount * 1.18),\n    customer_city: `${customer} - ${city}`\n  }\n}));"
      },
      "id": "3",
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "order_id",
        "options": {}
      },
      "id": "4",
      "name": "Split Out",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsRepeatedly",
        "fieldToCheck": "order_id",
        "options": {}
      },
      "id": "5",
      "name": "Remove Duplicates",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        940,
        300
      ]
    },
    {
      "parameters": {
        "operation": "formatDate",
        "date": "={{ $json.order_date }}",
        "format": "dd-MM-yyyy HH:mm",
        "outputFieldName": "formatted_date"
      },
      "id": "6",
      "name": "Date & Time",
      "type": "n8n-nodes-base.dateTime",
      "typeVersion": 2,
      "position": [
        1180,
        300
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "all_orders",
        "options": {}
      },
      "id": "7",
      "name": "Aggregate",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1420,
